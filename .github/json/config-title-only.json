{
  "categories": [],
  "sort": "ASC",
  "template": "## Version [v#{{VERSION}}](#{{RELEASE_DIFF}})",
  "custom_placeholders": [
    {
      "name": "VERSION",
      "source": "TO_TAG",
      "transformer": {
        "pattern": "v?([0-9\\.]+)(-[0-9\\.]+)?",
        "target": "$1"
      }
    }
  ],
  "empty_template": "",
  "tag_resolver": {
    "method": "semver",
    "filter": {
      "pattern": "^(?!v?[0-9\\.]+(-1\\.21\\.1)$).+$",
      "flags": "gu"
    },
    "transformer": {
      "pattern": "v?([0-9\\.]+)(-[0-9\\.]+)?",
      "target": "$1"
    }
  },
  "max_back_track_time_days": 365,
  "base_branches": ["1.21.1"]
}
